<a href="/glossary/schedules.html" style="display:inline-block;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:0.5rem 1rem;margin:0.25rem;color:var(--accent);text-decoration:none;font-size:0.9rem">Schedules</a>
<a href="/glossary/filing-fee.html" style="display:inline-block;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:0.5rem 1rem;margin:0.25rem;color:var(--accent);text-decoration:none;font-size:0.9rem">Filing Fee</a>
<a href="/glossary/voluntary-petition.html" style="display:inline-block;background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:0.5rem 1rem;margin:0.25rem;color:var(--accent);text-decoration:none;font-size:0.9rem">Voluntary Petition</a>
</div>
